#!/bin/bash
set -u

mode="${1:-}"
if [[ -n "$mode" && "$mode" != "--notify" ]]; then
  echo "Usage: check-dependencies [--notify]" >&2
  exit 2
fi

packages=()

add_package() {
  local package
  for package in "$@"; do
    if [[ " ${packages[*]} " != *" $package "* ]]; then
      packages+=("$package")
    fi
  done
}

if ! command -v python3 >/dev/null 2>&1; then
  add_package python gtk4 python-gobject
elif ! timeout 5s python3 -I -c \
  'import gi; gi.require_version("Gtk", "4.0"); from gi.repository import Gtk; assert Gtk.get_major_version() == 4' \
  >/dev/null 2>&1; then
  add_package gtk4 python-gobject
fi

command -v yt-dlp >/dev/null 2>&1 || add_package yt-dlp
# Share the version-aware runtime probe with the actual downloader. Node is
# explicitly enabled by the loader; yt-dlp otherwise enables only Deno.
if command -v python3 >/dev/null 2>&1 && ! timeout 8s python3 \
  "${BASH_SOURCE[0]%/*}/downloader.py" --check-runtime >/dev/null 2>&1; then
  add_package deno
fi
# Arch's yt-dlp package needs its matching EJS package. Standalone/pip builds
# may bundle EJS themselves, so do not infer their state from pacman alone.
yt_dlp_binary="$(command -v yt-dlp 2>/dev/null || true)"
if [[ -n "$yt_dlp_binary" ]] && [[ "$(pacman -Qqo "$yt_dlp_binary" 2>/dev/null)" == yt-dlp ]]; then
  pacman -Qq yt-dlp-ejs >/dev/null 2>&1 || add_package yt-dlp-ejs
fi
if ! command -v ffmpeg >/dev/null 2>&1 || ! command -v ffprobe >/dev/null 2>&1; then
  add_package ffmpeg
fi
# Game.qml is Qt 6 QML. A system that also has qt5-declarative installed keeps
# the Qt 5 runtime at /usr/bin/qml, where it shadows Qt 6 on PATH, so a bare
# "command -v qml" does not prove the requirement is met. Prefer the versioned
# Qt 6 path, then qml6, and accept a plain "qml" only when it reports Qt 6.
qt6_qml=""
for candidate in \
  "${RHYTHM_FORGE_QT6_QML:-/usr/lib/qt6/bin/qml}" \
  "$(command -v qml6 2>/dev/null || true)" \
  "$(command -v qml 2>/dev/null || true)"; do
  [[ -n "$candidate" && -x "$candidate" ]] || continue
  banner="$(timeout 10s "$candidate" -v 2>&1 || true)"
  if [[ "$banner" == *"Qml Runtime 6"* ]]; then
    qt6_qml="$candidate"
    break
  fi
done
if [[ -z "$qt6_qml" ]]; then
  add_package qt6-declarative
fi
pacman -Qq qt6-multimedia >/dev/null 2>&1 || add_package qt6-multimedia
pacman -Qq qt6-multimedia-ffmpeg >/dev/null 2>&1 || add_package qt6-multimedia-ffmpeg

if ((${#packages[@]} == 0)); then
  echo "Rhythm Forge is ready."
  exit 0
fi

package_list="${packages[*]}"
message="Missing packages: $package_list. Install with: omarchy-pkg-add $package_list"
echo "$message"

if [[ "$mode" == "--notify" ]]; then
  omarchy-notification-send \
    -u critical \
    -g "" \
    "Rhythm Forge needs dependencies" \
    "Missing: $package_list. Click to install with Omarchy." \
    --exec omarchy-launch-floating-terminal-with-presentation omarchy-pkg-add "${packages[@]}" \
    >/dev/null 2>&1 || true
fi

exit 1
